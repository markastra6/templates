{
  "private": true,
  "devDependencies": {
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1"
  },
  "type": "module",
  "name": "templates-directory-starter",
  "scripts": {
    "lint": "node --check site/directory.js && node --check site/ui-explorer.js && node --check site/ui-tools.js && node --check scripts/build-site.mjs",
    "typecheck": "tsc --allowJs --checkJs --noEmit --target es2022 site/directory.js site/ui-explorer.js site/ui-tools.js",
    "build": "node scripts/build-site.mjs",
    "test": "node --test browser-tests/*.unit.mjs"
  },
  "version": "1.0.0"
}
